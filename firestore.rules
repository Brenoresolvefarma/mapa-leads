rules_version = '2';

// Regras de segurança do Firestore do MapaLeads (Fase 2).
//
// Princípios:
//  - O navegador NUNCA grava nada. Buscas, leads, usuários e fila são gravados
//    só pelo servidor (Netlify Functions e motor no GitHub Actions, via Admin SDK,
//    que ignora estas regras).
//  - Usuário comum lê SOMENTE as próprias buscas e os próprios leads, mais as que o admin liberou para ele.
//  - Admin (custom claim admin=true, gravada só pelo servidor) lê tudo.
//  - O papel vem do token assinado pelo Firebase: o usuário não consegue alterá-lo.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function admin() {
      return logado() && request.auth.token.admin == true;
    }

    function dono(dados) {
      return logado() && dados.dono_uid == request.auth.uid;
    }

    // Busca liberada pelo admin para o vendedor (Function /api/liberar-busca).
    function liberada(dados) {
      return logado() && request.auth.uid in dados.get('liberada_para', []);
    }

    match /buscas/{buscaId} {
      allow read: if admin() || dono(resource.data) || liberada(resource.data);
      allow write: if false;

      // Leads em lotes de até 300 por documento. "Lista inteira" liberada: o lote traz liberada_para.
      match /lotes/{lote} {
        allow read: if admin() || dono(resource.data) || liberada(resource.data);
        allow write: if false;
      }

      // Recorte liberado (só algumas cidades e/ou dividido entre vendedores): cópia SÓ com os leads
      // das cidades daquele vendedor, num caminho com o uid dele — cada um lê só o seu.
      match /liberacoes/{uid}/lotes/{lote} {
        allow read: if admin() || (logado() && request.auth.uid == uid);
        allow write: if false;
      }
    }

    // Perfil e contador do limite diário: o próprio usuário lê, só o servidor grava.
    match /usuarios/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow write: if false;
    }

    // Estado público da fila: só IDs, tipo e tempo estimado (sem dono, termos ou cidades).
    match /fila/estado {
      allow read: if logado();
      allow write: if false;
    }

    // Configuração geral (ex.: limite diário padrão): leitura para logados.
    match /config/geral {
      allow read: if logado();
      allow write: if false;
    }

    // Números do dia (painel "Hoje"): {dia}__{uid} o próprio usuário lê; {dia}__geral só o admin.
    // Só contagens (buscas, leads, com WhatsApp, com telefone), nunca dados de leads.
    match /estatisticas/{id} {
      allow read: if admin()
        || (logado() && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}__' + request.auth.uid + '$'));
      allow write: if false;
    }

    // Mini-CRM: status/anotações de cada vendedor em crm/{uid}__{fatia} (16 fatias por vendedor).
    // Só o próprio vendedor (pelo id do documento, mesmo que ainda não exista) e o admin leem. Grava só a Function.
    match /crm/{id} {
      allow read: if admin() || (logado() && id.matches('^' + request.auth.uid + '__[0-9]{2}$'));
      allow write: if false;
    }

    // Carteira: de quem é cada estabelecimento (chave do lugar → uid, nome do vendedor, status, datas).
    // Todo logado lê (para mostrar "Na carteira de <nome>"); sem dados do lead. Grava só a Function.
    match /carteira/{fatia} {
      allow read: if logado();
      allow write: if false;
    }

    // Qualquer outra coisa (inclui perfis salvos, métricas e despertador): bloqueada.
    // Perfis são lidos e gravados só pela Function /api/perfis.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
